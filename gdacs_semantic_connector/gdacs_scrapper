#!/usr/bin/env python3
"""
GDACS Flood Geometry Scraper
===========================

This script discovers and downloads polygon (GeoJSON) geometries for a
range of Global Disaster Alert and Coordination System (GDACS) flood
events.  The workflow is split into two major phases:

1. Discovery – Probe each `(event_id, episode_id)` pair to find out
   which combinations actually have geometry available.
2. Download  – Persist every discovered GeoJSON to disk and generate
   a manifest CSV for later processing.

The two phases approach is necessary because many flood events never progress
beyond episode 1, while some receive multiple updates.  Probing first avoids
creating empty placeholder files, speeds up the overall runtime, and respects the
remote API’s rate‑limits.

The script is intentionally conservative: it throttles requests, adds
jitter to look less like a bot, retries nothing, and fails fast when
aithing goes wrong – because a single corrupt file is often worse than a
missing one (easy to notice and re‑run).

Usage
-----
Simply run the script – it takes all configuration values from the
«CONFIGURATION» section below.  Adapt them as needed and re‑execute.

Example::

    $ python gdacs_scraper.py

After completion you will have a tree like::

    ...\JSTARS\.venv\FL\  ( GDACS event-type code you root folder as choosen in the script EVENT_TYPE = "FL" for Flood)
    │
    ├── FL_1100000\
    ├── FL_1100100\
    ├── FL_1100101\
    ├── FL_1100102\
    ├── FL_1100103\                    (event 1100103)
            ├── FL_1100103_1.geojson   (episode 1)
            ├── FL_1100103_2.geojson   (episode 2)
            ├── FL_1100103_3.geojson   (episode 3)
            ...
            ├── FL_1100103_9.geojson   (episode 9)
    ├── FL_1100104\
    └── ...


    flood_manifest.csv

Each row of 'flood_manifest.csv' is the 3‑tuple `event_type,event_id,episode_id`.


Dependencies
------------
* Python ≥ 3.8
* 'requests'

The rest are from the standard library.
"""

from __future__ import annotations

import csv
import json
import os
import random
import sys
import time
from pathlib import Path
from typing import Dict, Tuple, List

import requests

# ─── CONFIGURATION ─────────────────────────────────────────────────────────────
# Base endpoint for the GDACS polygon API.
BASE_URL     = "https://www.gdacs.org/gdacsapi/api/polygons/getgeometry"

# GDACS event‑type code: "FL"= Flood, "TC"= Tropical Cyclone, etc.
EVENT_TYPE   = "WF"            # Flood

# Inclusive 'range' of GDACS 'event' identifiers to probe.
START_ID     = 1024111
END_ID       = 1024313

# Path of the CSV manifest that will be written (over‑written if present). A neutral name will be recommended
# to avoid changing filename each time when it is updated
OUTPUT_CSV   = "wildfire_manifest.csv"

# Throttling parameters – every HTTP call is delayed by ``DELAY`` ± ``JITTER``
# seconds.  This helps to obey polite crawling practices and keeps us well
# under GDACS’ published limits.
DELAY        = 1.0             # Base seconds between requests
JITTER       = 0.5             # Adds randomness (uniform distribution)

# Root directory under which per‑event folders will be created, e.g.::
#     FL/FL_1103336/FL_1103336_1.geojson
PARENT_DIR   = EVENT_TYPE      # Produces a top‑level folder named “FL/”

# Network timeout (seconds).  Long‑running requests are aborted to prevent the
# script from hanging indefinitely.
TIMEOUT      = 10
# ────────────────────────────────────────────────────────────────────────────────

# Convenience alias for our unique key type
ManifestKey = Tuple[str, int, int]  # (event_type, event_id, episode_id)

def check_geometry(event_id: int, episode_id: int):
    """Low‑level helper that queries GDACS for one (event, episode).

    Parameters
    ----------
    event_id : int
        GDACS global identifier of the disaster event.
    episode_id : int
        Sequential identifier of the episode/update issued for the event.

    Returns
    -------
    tuple
        (exists: bool, geojson: dict | None)

        * 'exists' – True  iff the request succeeded (HTTP 200) and
          the payload contains at least one GeoJSON feature.
        * 'geojson' – Parsed JSON body when 'exists' is 'True';
          otherwise 'None'.
    """
    params = {
        "eventtype": EVENT_TYPE,
        "eventid":   event_id,
        "episodeid": episode_id,
    }
    try:
        # Perform the HTTP GET call – raise an exception for any 4xx/5xx codes.
        r = requests.get(BASE_URL, params=params, timeout=TIMEOUT)
        r.raise_for_status()

        # Convert response body to a Python dictionary.
        data = r.json()

        # GDACS returns an *empty* ``features`` list when geometry is missing.
        if data.get("features"):
            return True, data
    except (requests.exceptions.RequestException, ValueError) as e:
        # Catch network errors *and* JSON decode failures.
        sys.stderr.write(f"\n⚠️  skip {EVENT_TYPE} {event_id}/{episode_id}: {e}\n")

    # No valid geometry – caller will ignore this pair.
    return False, None

def load_existing_manifest(fp: Path) -> Dict[ManifestKey, Dict[str, str]]:
    """Return a dict of rows from 'fp' or an empty dict if file absent."""
    rows: Dict[ManifestKey, Dict[str, str]] = {}
    if fp.exists():
        with fp.open(newline="", encoding="utf-8") as csvf:
            reader = csv.DictReader(csvf)
            for row in reader:
                try:
                    key: ManifestKey = (
                        row["event_type"],
                        int(row["event_id"]),
                        int(row["episode_id"]),
                    )
                    rows[key] = row
                except (KeyError, ValueError):
                    # Malformed line – skip but warn.
                    sys.stderr.write(f"⚠️  malformed row in manifest ignored: {row}\n")
    return rows


def write_manifest(fp: Path, rows: Dict[ManifestKey, Dict[str, str]]):
    """Write *rows* back to 'fp' sorted by event & episode id for stability."""
    with fp.open("w", newline="", encoding="utf-8") as csvf:
        fieldnames = ["event_type", "event_id", "episode_id"]
        writer = csv.DictWriter(csvf, fieldnames=fieldnames)
        writer.writeheader()
        for _, row in sorted(rows.items(), key=lambda kv: (kv[0][1], kv[0][2])):
            writer.writerow(row)

def main():  # noqa: C901 – function intentionally linear & verbose for clarity
    total_events = END_ID - START_ID + 1
    print(f"▶ Scraping geometry for {EVENT_TYPE} events {START_ID}→{END_ID}")

    discovered: List[Tuple[int, int, dict | None]] = []
    checked = 0

    # ── 1️⃣ DISCOVER VALID EPISODES ────────────────────────────────────────────
    for eid in range(START_ID, END_ID + 1):
        checked += 1
        sys.stdout.write(f"\r[{checked}/{total_events}] event {eid} … ")
        sys.stdout.flush()

        # First episode always 1.
        time.sleep(DELAY + random.uniform(-JITTER, JITTER))
        ok, geo = check_geometry(eid, 1)
        if not ok:
            continue  # nothing for this event
        discovered.append((eid, 1, geo))
        sys.stdout.write("1")

        # Probe follow‑up episodes incrementally.
        ep = 2
        while True:
            time.sleep(DELAY + random.uniform(-JITTER, JITTER))
            ok, geo = check_geometry(eid, ep)
            if not ok:
                break
            discovered.append((eid, ep, geo))
            sys.stdout.write(f",{ep}")
            ep += 1

    print(f"\n✔ Discovery finished: {len(discovered)} new pairs found.")

    # ── 2️⃣ MERGE WITH EXISTING MANIFEST ──────────────────────────────────────
    manifest_path = Path(OUTPUT_CSV)
    manifest: Dict[ManifestKey, Dict[str, str]] = load_existing_manifest(manifest_path)

    for eid, ep, _ in discovered:
        key: ManifestKey = (EVENT_TYPE, eid, ep)
        # Add or replace.
        manifest[key] = {
            "event_type": EVENT_TYPE,
            "event_id": str(eid),
            "episode_id": str(ep),
        }

    write_manifest(manifest_path, manifest)
    print(f"→ Manifest updated ({len(manifest)} total rows): {manifest_path}")

    # ── 3️⃣ DOWNLOAD GEOJSON FILES ─────────────────────────────────────────────
    print("▶ Downloading GeoJSON files …")
    Path(PARENT_DIR).mkdir(exist_ok=True)

    for eid, ep, geojson in discovered:
        ev_dir = Path(PARENT_DIR) / f"{EVENT_TYPE}_{eid}"
        ev_dir.mkdir(exist_ok=True)
        fp = ev_dir / f"{EVENT_TYPE}_{eid}_{ep}.geojson"

        if geojson is not None:
            with fp.open("w", encoding="utf-8") as f:
                json.dump(geojson, f)
        else:
            # should be rare – fallback to direct download
            params = {"eventtype": EVENT_TYPE, "eventid": eid, "episodeid": ep}
            try:
                r = requests.get(BASE_URL, params=params, timeout=TIMEOUT)
                r.raise_for_status()
                fp.write_text(r.text, encoding="utf-8")
            except requests.exceptions.RequestException as exc:
                sys.stderr.write(f"⚠️  failed to download {eid}/{ep}: {exc}\n")

        time.sleep(DELAY + random.uniform(-JITTER, JITTER))

    print("✅ All done.")


if __name__ == "__main__":
    main()
