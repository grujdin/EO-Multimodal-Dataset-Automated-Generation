#!/usr/bin/env python3
"""
Incremental wildfire-episode filter & downloader.

• INPUT_FILE ─ raw table (event_type, event_id, episode_id …).
• OUTPUTS    ─ wf_filtered_output_<LAST_EVENT>.{csv,xlsx}
               – always contains *one* row per event (highest episode).
• GEOJSON    ─ missing episodes are downloaded to <GEOJSON_DIR>/<etype>_<eid>_<ep>.geojson
"""

from pathlib import Path
import re
import json
import os
import requests
import pandas as pd

# ─── USER SETTINGS ─────────────────────────────────────────
INPUT_FILE   = "wildfire_1000000-1024111.csv"       # or .xlsx
GEOJSON_DIR  = Path("WF_Summary")
GDACS_URL    = "https://www.gdacs.org/gdacsapi/api/polygons/getgeometry"
TIMEOUT_SECS = 10
# ───────────────────────────────────────────────────────────

# ---------------------------------------------------------------------------
def load_any(path: Path) -> pd.DataFrame:
    if path.suffix.lower() == ".xlsx":
        return pd.read_excel(path)
    if path.suffix.lower() == ".csv":
        return pd.read_csv(path)
    raise ValueError(f"Unsupported file type: {path}")

def keep_max_episode(df: pd.DataFrame) -> pd.DataFrame:
    """One row (max episode) per event_id."""
    return (
        df.sort_values("episode_id", ascending=False)
          .drop_duplicates(subset=["event_id"], keep="first")
          .sort_values("event_id")
          .reset_index(drop=True)
    )

def find_existing_outputs() -> pd.DataFrame:
    """Merge every wf_filtered_output_*.csv / .xlsx (if any) into one DF."""
    files = sorted(Path(".").glob(r"wf_filtered_output_*.*"))
    dfs   = []
    for p in files:
        try:
            dfs.append(load_any(p))
        except Exception:
            pass   # ignore weird files
    return pd.concat(dfs, ignore_index=True) if dfs else pd.DataFrame()

def download_geojson(row, dest_dir: Path):
    etype, eid, epid = row["event_type"], row["event_id"], row["episode_id"]
    url  = f"{GDACS_URL}?eventtype={etype}&eventid={eid}&episodeid={epid}&source=OverAll"
    dest = dest_dir / f"{etype}_{eid}_{epid}.geojson"
    if dest.exists():          # already on disk
        return

    print(f"  ↳ GET {url}")
    try:
        r = requests.get(url, timeout=TIMEOUT_SECS)
        if r.ok and r.text.strip():
            dest_dir.mkdir(exist_ok=True, parents=True)
            dest.write_text(r.text, encoding="utf-8")
            print(f"    ✔ saved → {dest}")
        else:
            print(f"    ✘ empty / HTTP {r.status_code}")
    except requests.exceptions.RequestException as e:
        print(f"    ❌ {e}")

# ---------------------------------------------------------------------------
def main() -> None:
    src   = Path(INPUT_FILE)
    raw   = load_any(src)

    # ① keep only highest episode per event in the *source file*
    fresh = keep_max_episode(raw)

    # ② read previous outputs (if any) to know what's already processed
    already = find_existing_outputs()
    already_ids = set(already["event_id"]) if not already.empty else set()

    to_add = fresh[~fresh["event_id"].isin(already_ids)].copy()
    if to_add.empty:
        print("Nothing new – all events already present.")
        return

    print(f"New events to add: {len(to_add)}")

    # ③ download missing GeoJSONs
    for _, r in to_add.iterrows():
        download_geojson(r, GEOJSON_DIR)

    # ④ append and write new ‘current’ output
    combined = (
        pd.concat([already, to_add], ignore_index=True)
          .sort_values("event_id")
          .reset_index(drop=True)
    )

    last_event = combined["event_id"].max()
    out_base   = f"wf_filtered_output_{last_event}"

    combined.to_csv (f"{out_base}.csv" , index=False)
    combined.to_excel(f"{out_base}.xlsx", index=False)

    print(f"✅ Written {out_base}.csv / .xlsx   (total rows: {len(combined)})")

# ---------------------------------------------------------------------------
if __name__ == "__main__":
    main()
