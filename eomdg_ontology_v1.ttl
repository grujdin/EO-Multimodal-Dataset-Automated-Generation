eomdg:sampleDerivedFromObservation
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain eomdg:TrainingSample ;
    rdfs:range eomdg:HazardObservation ;
    rdfs:label "sample derived from observation" .

eomdg:sampleDerivedFromFootprint
    a owl:ObjectProperty ;
