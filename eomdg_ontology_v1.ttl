eomdg:yOffsetPx
    a owl:DatatypeProperty ;
    rdfs:domain eomdg:ImageChip ;
    rdfs:range xsd:integer .

eomdg:pixelSizeX
    a owl:DatatypeProperty ;
    rdfs:domain eomdg:DataItem ;
    rdfs:range xsd:decimal .

eomdg:pixelSizeY
    a owl:DatatypeProperty ;
    rdfs:domain eomdg:DataItem ;
    rdfs:range xsd:decimal .

eomdg:overlapFraction
    a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:decimal ;
