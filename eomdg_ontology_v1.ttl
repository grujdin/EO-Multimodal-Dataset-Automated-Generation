eomdg:productType
    a owl:DatatypeProperty ;
    rdfs:domain eomdg:DataItem ;
    rdfs:range xsd:string ;
    rdfs:label "product type" .

eomdg:processingLevel
    a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "processing level" .

