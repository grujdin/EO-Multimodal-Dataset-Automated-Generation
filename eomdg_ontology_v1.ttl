eomdg:sampleDerivedFromRecord
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain eomdg:TrainingSample ;
    rdfs:range eomdg:ProcessedObservationRecord ;
