eomdg:parameterJSON
    a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "parameter JSON" .

eomdg:versionIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain eomdg:DatasetVersion ;
    rdfs:range xsd:string ;
